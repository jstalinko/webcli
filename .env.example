# WebCLI Server Configuration
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# Authentication & Security
JWT_SECRET=cyber-secret-change-this-in-production-random-bytes
JWT_EXPIRES_IN=7d

# File Storage & Database
DATA_DIR=./data
WORKSPACES_ROOT=./workspaces

# Shell Execution
SHELL=/bin/bash
MAX_FILE_SIZE_MB=50
